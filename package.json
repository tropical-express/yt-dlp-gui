{
  "name": "yt-dlp-gui",

  "version": "1.1.0",

  "description": "Simple Electron frontend for yt-dlp",

  "main": "src/main/main.js",

  "author": "Jacob Yee",

  "license": "GPL-3.0",

  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },

  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },

  "build": {

    "appId": "com.jacobyee.ytdlpgui",

    "productName": "YT-DLP GUI",

    "asar": true,

    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],

    "directories": {
      "output": "dist"
    },

    "win": {

      "target": [
        "nsis",
        "portable"
      ],

      "icon": "assets/icon.ico"

    },

    "linux": {

      "target": [
        "AppImage"
      ],

      "icon": "assets",

      "category": "Utility"

    }

  }

}